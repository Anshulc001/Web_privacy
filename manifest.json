{
  "manifest_version": 3,
  "name": "WebGuard",
  "version": "0.1.0",
  "description": "Local privacy and security overview for the sites you visit.",
  "key": "",
  "action": {
    "default_title": "WebGuard",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [{ "id": "ad_tracker_rules", "enabled": true, "path": "data/ad-tracker-rules.json" }]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "webNavigation",
    "scripting",
    "activeTab",
    "cookies",
    "declarativeNetRequest",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"
  }
}
